OPENCLAW_WS_URL=ws://localhost:18789
# 本地或部署环境填写 Gateway 凭据；不得提交真实值。
OPENCLAW_AUTH_TOKEN=
OPENCLAW_AUTH_PASSWORD=
PORT=3000
GAIOP_BIND_HOST=127.0.0.1
# 生产必须显式配置允许的浏览器Origin，多个值用英文逗号分隔；禁止通配符。
GAIOP_ALLOWED_ORIGINS=
GAIOP_ADMIN_DATA_DIR=
GAIOP_ADMIN_BACKUP_DIR=
OPENCLAW_DEVICE_IDENTITY_PATH=
DEV_PORT=3001
AUTH_USERNAME=admin
# 首次初始化时在本地或部署环境设置管理员密码；不得提交真实值。
AUTH_PASSWORD=
# 用于加密保存 NAPM 数据源密码；生产环境请使用随机高强度值，勿提交真实值。
DATA_SOURCE_ENCRYPTION_KEY=replace-with-a-random-production-secret
# 报告来源用户归属：启用后由 Admin BFF 签发、GAIOP 插件验签。
# 仅在 Gateway 已确认透传 chat.send metadata 时启用；两个仓库必须配置同一个 32 字符以上随机密钥。
GAIOP_REPORT_PROVENANCE_ENABLED=false
GAIOP_REPORT_PROVENANCE_SIGNING_KEY=
# GAIOP-Admin 写入、GAIOP 智能体核心读取的同一个活动数据源文件。
# 生产环境必须配置为双方可访问的同一绝对路径；文件仅允许服务账户读取。
# 开发环境未配置时使用相邻 GAIOP/config/runtime-active-data-source.json。
GAIOP_ACTIVE_DATA_SOURCE_FILE=
# 旧管理端部署兼容别名；新部署不要同时设置两个变量。
# GAIOP_DATA_SOURCE_RUNTIME_FILE=
# 报告专用目录。部署时需要与 GAIOP 智能体服务的 GAIOP_REPORTS_DIR 指向同一受控目录（或同一容器挂载卷）。
# GAIOP_REPORTS_DIR=
LOG_LEVEL=INFO
# 正式 Syslog 告警接收器仅允许 BFF 经部署侧本机/私网地址访问；不要提交真实 Token。
GAIOP_ALERT_RECEIVER_URL=http://127.0.0.1:19090
GAIOP_ALERT_RECEIVER_TOKEN=
# 以下 SSH 字段仅保留历史本地开发兼容；正式 ISO 不使用 SSH 读取作为告警数据源。
GAIOP_ALERT_SSH_HOST=
GAIOP_ALERT_SSH_PORT=22
GAIOP_ALERT_SSH_USERNAME=
GAIOP_ALERT_SSH_PASSWORD=
GAIOP_ALERT_SSH_PRIVATE_KEY_PATH=
GAIOP_ALERT_SYSLOG_PATH=/var/log/netinside/syslog.log
# 系统升级服务仅允许由 Admin BFF 调用；ISO 部署时填写内部地址和随机令牌。
# 不要在前端变量、Git 或日志中放入真实令牌。
GAIOP_UPGRADE_SERVICE_URL=
GAIOP_UPGRADE_INTERNAL_TOKEN=
#OPENCLAW_HOME=/home/ubuntu

# Hermes Agent Configuration
HERMES_WEB_URL=http://localhost:9119
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=

# TTS (Text-to-Speech) Configuration
VITE_TTS_ENABLED=true
VITE_TTS_AUTO_PLAY=false
VITE_TTS_VOICE=zh-CN
VITE_TTS_RATE=1.0
VITE_TTS_VOLUME=1.0
VITE_TTS_PITCH=1.0
