[Unit]
Description=GAIOP Admin retention cleanup
After=gaiop-admin.service

[Service]
Type=oneshot
User=gaiop
Group=gaiop
WorkingDirectory=/opt/gaiop/admin
EnvironmentFile=/etc/gaiop/admin.env
ExecStart=/usr/local/bin/node /opt/gaiop/admin/server/admin-retention-cleanup.js
UMask=0027
RuntimeDirectory=gaiop-admin-retention
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gaiop/admin
ReadWritePaths=-/var/lib/gaiop/runtime/report-provenance
ReadWritePaths=-/opt/gaiop/admin/data/upgrade-upload-staging
ReadWritePaths=/run/gaiop-admin-retention
