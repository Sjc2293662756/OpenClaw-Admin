# GAIOP ISO Caddy access-log fragment.
# Import this file exactly once inside the active GAIOP HTTPS site block.
# The log directory owner must match the live Caddy service account.
log {
	output file /var/log/gaiop/caddy/access.log {
		mode 0640
		roll_size 100MiB
		roll_at 00:00
		roll_keep 0
		roll_keep_for 8760h
	}
	format filter {
		request>headers>Authorization delete
		request>headers>Proxy-Authorization delete
		request>headers>Cookie delete
		request>headers>X-Api-Key delete
		request>headers>X-Auth-Token delete
		resp_headers>Set-Cookie delete
		request>uri regexp "\\?.*$" "?[QUERY_REDACTED]"
		request>body delete
		request>body_base64 delete
		response>body delete
		response>body_base64 delete
		wrap json
	}
}
