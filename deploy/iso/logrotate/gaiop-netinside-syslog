"/var/log/netinside/syslog.log" {
    daily
    rotate -1
    maxage 365
    missingok
    notifempty
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d-%H%M%S
    create 0640
    noallowhardlink
    sharedscripts
    postrotate
        /bin/systemctl kill --kill-who=main --signal=HUP rsyslog.service
    endscript
}
