# Copy to /etc/gaiop/admin.env. Replace blank secret values only through the
# controlled deployment process; never commit the completed file.
PORT=3000
GAIOP_BIND_HOST=127.0.0.1
GAIOP_ADMIN_DATA_DIR=/var/lib/gaiop/admin
GAIOP_ADMIN_BACKUP_DIR=/var/lib/gaiop/admin/backups
GAIOP_ADMIN_SQLITE_BACKUP_DIR=/var/lib/gaiop/admin/sqlite-backups
GAIOP_ADMIN_SQLITE_BACKUP_CREATE_ENABLED=false
GAIOP_ADMIN_SQLITE_BACKUP_CLEANUP_ENABLED=false
GAIOP_ADMIN_SQLITE_BACKUP_LOCK_PATH=/run/gaiop-admin-sqlite-backup/backup.lock
GAIOP_ADMIN_SQLITE_RESTORE_TEST_DIR=/var/lib/gaiop/admin/sqlite-restore-tests
OPENCLAW_DEVICE_IDENTITY_PATH=/var/lib/gaiop/admin/gateway-device-identity.json
AUTH_USERNAME=admin
AUTH_PASSWORD=
DATA_SOURCE_ENCRYPTION_KEY=
SENSITIVE_CONFIG_ENCRYPTION_KEY=
GAIOP_ACTIVE_DATA_SOURCE_FILE=/var/lib/gaiop/runtime/runtime-active-data-source.json
GAIOP_REPORTS_DIR=/var/lib/gaiop/reports
GAIOP_REPORT_RECOVERY_DIR=/var/lib/gaiop/report-recovery
GAIOP_REPORT_RETENTION_AUTO_PROCESS=false
GAIOP_REPORT_RETENTION_MAX_ITEMS=50
GAIOP_REPORT_RETENTION_LOCK_PATH=/run/gaiop-report-retention/retention.lock
GAIOP_ALERT_RECEIVER_URL=http://127.0.0.1:19090
GAIOP_ALERT_RECEIVER_TOKEN=
GAIOP_REPORT_PROVENANCE_ENABLED=false
GAIOP_REPORT_PROVENANCE_SIGNING_KEY=
LOG_LEVEL=INFO
